generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String?  @unique
  name              String?
  avatarUrl         String?
  bio               String?
  stripeConnectId   String?  @unique
  stripeConnectOnboarded Boolean @default(false)
  role              UserRole @default(USER)
  trustLevel        TrustLevel @default(NEW)
  strikeCount       Int      @default(0)
  lastStrikeAt      DateTime?
  bannedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products       Product[]
  videos         Video[]
  events         Event[]
  subscription   Subscription?
  carts          Cart[]
  merchant       Merchant?
  commissions    Commission[]
  orders         Order[]
  reports             Report[]       @relation("ReporterReports")
  moderationLogs      ModerationLog[]
  creatorApplications CreatorApplication[]
  following           Follow[]       @relation("UserFollowing")
  followers           Follow[]       @relation("UserFollowers")
  savedItems          SavedItem[]
  adminMessages       AdminMessage[]
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum TrustLevel {
  NEW
  BASIC
  ESTABLISHED
  TRUSTED
}

model Video {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cloudflareStreamId String?        @unique
  thumbnailUrl       String?
  hlsUrl             String?
  dashUrl            String?
  duration           Float?
  status             VideoStatus    @default(PROCESSING)
  published          Boolean        @default(false)
  title              String?
  description        String?
  category           String?
  location           String?
  products           VideoProduct[]
  events             Event[]
  score              VideoScore?
  reports            Report[]
  moderationLogs     ModerationLog[]
  savedBy            SavedItem[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, published])
}

enum VideoStatus {
  PROCESSING
  READY
  PENDING_REVIEW
  REJECTED
  ERROR
}

model VideoProduct {
  id                String           @id @default(cuid())
  videoId           String
  video             Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchantProductId String?
  merchantProduct   MerchantProduct? @relation(fields: [merchantProductId], references: [id], onDelete: Cascade)
  position          Int              @default(0)
  createdAt         DateTime         @default(now())

  @@unique([videoId, productId])
  @@unique([videoId, merchantProductId])
  @@index([videoId, position])
}

model Product {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  brand        String?
  price        Float?
  priceDisplay String?
  imageUrl     String?
  description  String?
  affiliateUrl String
  sizes        Json?          // Array of available sizes, e.g. ["S", "M", "L", "XL"]
  tags         String?
  position     Int            @default(0)
  published    Boolean        @default(true)

  videos          VideoProduct[]
  clicks          Click[]
  events          Event[]
  cartItems       CartItem[]
  merchantProduct MerchantProduct?
  savedBy         SavedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, position])
}

model Click {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  visitorId String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Event {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewerSessionId String?
  videoId         String?
  video           Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  type            EventType
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([productId, type])
  @@index([videoId, type])
  @@index([viewerSessionId, type])
}

model VideoScore {
  id              String   @id @default(cuid())
  videoId         String   @unique
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  avgWatchPercent Float    @default(0)
  cartRate        Float    @default(0)
  shareRate       Float    @default(0)
  shopClickRate   Float    @default(0)
  totalViews      Int      @default(0)
  score           Float    @default(0)
  computedAt      DateTime @default(now())

  @@index([score(sort: Desc)])
}

enum EventType {
  PAGE_VIEW
  VIDEO_START
  VIDEO_COMPLETE
  SWIPE_NEXT
  SWIPE_PREV
  SHOP_CLICK
  ADD_TO_CART
  SHARE
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id                String           @id @default(cuid())
  cartId            String
  cart              Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchantProductId String?
  merchantProduct   MerchantProduct? @relation(fields: [merchantProductId], references: [id], onDelete: Cascade)
  selectedSize      String?
  quantity          Int              @default(1)
  createdAt         DateTime         @default(now())

  @@unique([cartId, productId])
  @@unique([cartId, merchantProductId, selectedSize])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 Plan      @default(FREE)
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum Plan {
  FREE
  CREATOR
  PRO
}

// ── Marketplace Models ──

model Merchant {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopifyDomain     String   @unique    // e.g. "mystore.myshopify.com"
  shopifyAccessToken String
  shopifyShopId     String?  @unique
  storeName         String?
  storeLogoUrl      String?
  shippingPolicy    String?
  returnPolicy      String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchantProducts MerchantProduct[]
  orders           Order[]
}

model MerchantProduct {
  id                 String   @id @default(cuid())
  merchantId         String
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shopifyProductId   String
  shopifyVariantId   String?
  title              String
  description        String?
  imageUrl           String?
  price              Float
  compareAtPrice     Float?
  currency           String   @default("USD")
  sku                String?
  inventoryQuantity  Int?
  available          Boolean  @default(true)
  productUrl         String?
  tags               String?
  productType        String?
  vendor             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Link to Scrollr products (many creators can tag the same merchant product)
  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  videoProducts VideoProduct[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([merchantId, shopifyProductId, shopifyVariantId])
  @@index([merchantId, available])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique @default(cuid())
  buyerEmail        String
  buyerName         String
  buyerUserId       String?     // links to User if buyer is logged in
  shippingAddress   Json        // { line1, line2, city, state, zip, country }
  trackingNumber    String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  merchantId        String
  merchant          Merchant    @relation(fields: [merchantId], references: [id])
  creatorId         String?
  creator           User?       @relation(fields: [creatorId], references: [id])
  videoId           String?     // Which video drove the sale
  subtotal          Float       // Product total before shipping
  shippingCost      Float       @default(0)
  total             Float       // subtotal + shipping
  platformFee       Float       // 1% to Scrollr
  creatorCommission Float       @default(0) // 3% to creator
  currency          String      @default("USD")
  stripePaymentId   String?     @unique
  shopifyOrderId    String?     @unique
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items       OrderItem[]
  commissions Commission[]

  @@index([buyerUserId, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([creatorId, createdAt(sort: Desc)])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantProductId String
  merchantProduct   MerchantProduct @relation(fields: [merchantProductId], references: [id])
  quantity          Int             @default(1)
  unitPrice         Float
  total             Float

  @@index([orderId])
}

model Commission {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String           // Creator who earned it
  user      User             @relation(fields: [userId], references: [id])
  amount    Float
  currency  String           @default("USD")
  type      CommissionType
  status    CommissionStatus @default(PENDING)
  stripeTransferId String?
  paidAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, status])
  @@index([orderId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CommissionType {
  CREATOR_SALE    // 3% to creator
  PLATFORM_FEE   // 1% to Scrollr
}

enum CommissionStatus {
  PENDING
  PAID
  FAILED
}

// ── Content Safety Models ──

model Report {
  id         String       @id @default(cuid())
  videoId    String
  video      Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([videoId, reporterId])
  @@index([videoId, status])
  @@index([reporterId, createdAt])
}

enum ReportReason {
  SEXUAL_CONTENT
  VIOLENCE
  HATE_SPEECH
  SPAM
  SCAM
  INVOLVES_MINOR
  COPYRIGHT
  SELF_HARM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model ModerationLog {
  id        String          @id @default(cuid())
  videoId   String
  video     Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User            @relation(fields: [adminId], references: [id])
  action    ModerationAction
  reason    String?
  createdAt DateTime        @default(now())

  @@index([videoId])
  @@index([adminId, createdAt])
}

enum ModerationAction {
  APPROVED
  REJECTED
  HIDDEN
  RESTORED
  USER_WARNED
  USER_BANNED
}

// ── Creator Application Models ──

model CreatorApplication {
  id          String                   @id @default(cuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      CreatorApplicationStatus @default(PENDING)
  category    String
  socialLinks Json
  pitch       String
  reviewedBy  String?
  reviewedAt  DateTime?
  adminNote   String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

enum CreatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Social Models ──

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@unique([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
}

model AdminMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  sentBy    String
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ── Discovery Models ──

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  position    Int     @default(0)
  active      Boolean @default(true)

  @@index([active, position])
}
